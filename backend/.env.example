# PostgreSQL connection string (Render: Internal Database URL of the shared database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
# Postgres schema that holds this app's tables
DB_SCHEMA=train_booking
PORT=5130
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5215
# Long random string used to sign JWTs (Render generates one)
JWT_SECRET=replace-with-a-long-random-string
# Optional: seeds admin@raildesk.dev with this password
ADMIN_PASSWORD=
