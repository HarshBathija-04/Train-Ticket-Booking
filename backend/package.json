{
  "name": "train-booking-api",
  "version": "1.0.0",
  "description": "RailYatra train booking REST API (Express + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/db/migrate.js",
    "seed": "node dist/src/db/seed.js",
    "db:setup": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "prettier": "3.10.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
